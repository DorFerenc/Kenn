# Kenn's web app needs two values, and only two.
#
# Copy this file to `.env.local` — or, with the local stack running, let
# `pnpm dev:env` fill it in from `supabase status`, which is less error-prone.
#
# Both of these are public by design: the publishable key carries no privileges
# of its own, and every request made with it is still subject to RLS. The secret
# key (`sb_secret_…`, formerly the service-role key) must NEVER appear here or
# anywhere in apps/web — it belongs to CI and the gov watcher. See CLAUDE.md,
# hard rule 1.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Fill this in from `supabase status`, or let `pnpm dev:env` do it. The
# placeholder is deliberately not key-shaped: check:private matches a
# publishable key by shape, and it is right to.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
