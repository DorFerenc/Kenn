{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "types": ["node"],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["src/**/*.ts", "lib/**/*.ts", "app/**/*.ts", "app/**/*.tsx"],
  "exclude": ["node_modules", ".next", "e2e"]
}
