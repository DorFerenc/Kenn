#!/usr/bin/env bash
#
# Refuse a commit when the gate is red.
#
# This exists because a commit once landed with a failing `pnpm check` and had to
# be amended. A red commit on a branch someone else pulls is a trap, and
# remembering to run the gate is exactly the kind of thing a tool should do.
#
# Installed by `pnpm install` (the `prepare` script sets core.hooksPath).
# Escape hatch, for a deliberate work-in-progress commit:
#     SKIP_CHECK=1 git commit ...
set -uo pipefail

if [ "${SKIP_CHECK:-}" = "1" ]; then
  printf 'pre-commit: skipped by SKIP_CHECK=1\n' >&2
  exit 0
fi

root=$(git rev-parse --show-toplevel)
cd "$root" || exit 0

if ! command -v pnpm >/dev/null 2>&1; then
  printf 'pre-commit: pnpm not on PATH; skipping the gate\n' >&2
  exit 0
fi

# What the working tree looks like before the gate runs. Compared with the same
# thing afterwards, so the check below can tell a file the GATE regenerated from
# a file that was simply not part of this commit.
#
# The earlier version asked `git diff --quiet` and refused on any unstaged
# change at all. That made a change spanning several commits impossible: the
# first `git add` of a subset left the rest unstaged, and the hook read that as
# the gate having regenerated something. It refused every commit but the last,
# which is the opposite of "one commit that says step 5 is not reviewable".
before=$(git diff)

# What this commit is about, printed before the gate runs.
#
# Twice now a commit has carried work it was not about: once from `git add -A`,
# once from an index still loaded by a commit the hook had refused. Neither is
# something a hook should guess at and block, but both are obvious the moment
# the paths are on screen — so they go on screen.
printf 'pre-commit: staged for this commit:\n' >&2
git diff --cached --name-only | sed 's/^/  /' >&2

printf 'pre-commit: running pnpm check (SKIP_CHECK=1 to bypass)\n' >&2
if ! out=$(pnpm check 2>&1); then
  printf '%s\n' "$out" >&2
  printf '\npre-commit: the gate is red, so the commit was refused.\n' >&2
  printf 'Fix it, or commit with SKIP_CHECK=1 if this is a deliberate WIP.\n' >&2
  exit 1
fi

# `pnpm check` regenerates the ER diagram, the KB catalogue, the i18n coverage
# document and the KB module. If running it changed any of them, that belongs in
# this commit rather than being discovered by CI.
after=$(git diff)
if [ "$before" != "$after" ]; then
  printf 'pre-commit: `pnpm check` regenerated files. Stage them and commit again:\n' >&2
  diff <(printf '%s\n' "$before") <(printf '%s\n' "$after") |
    sed -n 's/^[<>] diff --git a\/\([^ ]*\).*/  \1/p' | sort -u >&2
  exit 1
fi

printf 'pre-commit: gate green\n' >&2
