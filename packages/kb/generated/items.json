        "https://www.gov.il/he/service/genetic-survey-before-or-during-pregnancy"
      ],
      "valid_from": "2024-11-15",
      "review_by": "2027-06-01",
      "notes": "The uniform panel replaced the ethnic-origin model on 15 November 2024. People screened under the old model are advised to re-test.",
      "kind": "schedule",
      "window": {
        "anchor": "LMP",
        "start_days": -180,
        "end_days": 97
      },
      "rules": []
    },
