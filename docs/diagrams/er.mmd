erDiagram
  HOUSEHOLD ||--|{ MEMBER : has
  AUTH_USERS ||--|{ MEMBER : has
  HOUSEHOLD ||--|{ INVITE : has
  AUTH_USERS ||--|{ INVITE : has
  HOUSEHOLD {
    uuid id PK
    text name
    text country
    text default_locale
    timestamptz created_at
  }
  INVITE {
    uuid id PK
    uuid household_id FK
    text email
    text token_hash
    text role
    uuid invited_by FK
    timestamptz expires_at
    timestamptz accepted_at
    timestamptz revoked_at
    timestamptz created_at
  }
  MEMBER {
    uuid household_id PK,FK
    uuid user_id PK,FK
    text role
    text locale
    text gender_form
    timestamptz created_at
  }
  AUTH_USERS {
    uuid id PK
  }
